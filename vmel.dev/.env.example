# Local development only. Production uses generated values in the VPS .env file.
DATABASE_URL=postgres://vmel:vmel@127.0.0.1:5440/vmel
REDIS_URL=redis://127.0.0.1:6380
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@vmel.dev
# Set only while running db:admin; do not expose it to the web container.
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
