{
  "name": "vmel-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "oxlint --deny-warnings --react-plugin src tests scripts playwright.config.ts vite.config.ts",
